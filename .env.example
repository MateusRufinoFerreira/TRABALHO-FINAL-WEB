# Modelo de variaveis de ambiente. Copie para .env antes de rodar o projeto:
#
#   cp .env.example .env

# Credenciais do container Postgres (docker-compose.yml)
POSTGRES_USER="provius"
POSTGRES_PASSWORD="defina_uma_senha"
POSTGRES_DB="provius"

# Conexao do Prisma. Deve usar as mesmas credenciais definidas acima.
DATABASE_URL="postgresql://provius:defina_uma_senha@localhost:5432/provius?schema=public"

# Assinatura dos tokens JWT. Gere um valor com: openssl rand -base64 48
# Obrigatorio: a aplicacao falha se estiver ausente, em vez de usar um padrao.
JWT_SECRET=""

# --- Seed (opcional) ---------------------------------------------------------
# Professor criado por `npx prisma db seed`. Se omitidos, valem os padroes
# definidos em prisma/seed.js (thiago@uepb.edu.br / thiago123).
SEED_PROFESSOR_NOME=""
SEED_PROFESSOR_EMAIL=""
SEED_PROFESSOR_SENHA=""
