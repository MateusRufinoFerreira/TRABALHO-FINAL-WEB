datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String // hash bcrypt
  createdAt DateTime @default(now())

  turmas Turma[]
  bancos BancoQuestao[]
}

model Turma {
  id        String   @id @default(uuid())
  nome      String
  codigo    String
  semestre  String
  createdAt DateTime @default(now())

  usuarioId String
  professor Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  alunos     Aluno[]
  avaliacoes Avaliacao[]
}

model Aluno {
  id        String   @id @default(uuid())
  nome      String
  matricula String   @unique
  email     String
  createdAt DateTime @default(now())

  turmas     Turma[]
  avaliacoes Avaliacao[]
}

model BancoQuestao {
  id        String   @id @default(uuid())
  titulo    String
  createdAt DateTime @default(now())

  usuarioId String
  professor Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  questoes Questao[]
}

model Questao {
  id        String   @id @default(uuid())
  tipo      String // DISCURSIVA | MULTIPLA_ESCOLHA
  enunciado String
  peso      Float    @default(1.0)
  gabarito  String
  createdAt DateTime @default(now())

  bancoId String
  banco   BancoQuestao @relation(fields: [bancoId], references: [id], onDelete: Cascade)

  avaliacoes Avaliacao[]
}

model Avaliacao {
  id             String   @id @default(uuid())
  titulo         String
  tipo           String // PROVA | LISTA
  dataInicio     DateTime
  dataTermino    DateTime
  
  ordemAleatoria Boolean  @default(false)
  createdAt      DateTime @default(now())

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  alunos   Aluno[]
  questoes Questao[]
}
